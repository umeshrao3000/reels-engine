DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reels_engine?schema=public"

# Local dev storage (Storage Service abstraction). No cloud provider in V1.
STORAGE_DRIVER="local"
STORAGE_ROOT=".storage"

# Admin (single-passcode gate for V1; swappable for real auth+RBAC later)
ADMIN_PASSCODE=""
ADMIN_SESSION_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Owner Testing Mode — temporary QA-only flag. When "true", every new
# project is auto-marked as paid (Payment provider="owner_test") so the
# rest of the pipeline can be exercised without a real UPI payment. Leave
# unset (or anything other than "true") in production — this is the
# single switch that disables it.
OWNER_TEST_MODE=""

# Instagram Engagement Automation Engine (/api/webhooks/instagram)
# META_APP_SECRET signs/verifies X-Hub-Signature-256 on every inbound event.
# META_WEBHOOK_VERIFY_TOKEN is the arbitrary string configured in the Meta
# App Dashboard's Webhooks setup, echoed back during the GET subscription handshake.
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
