DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reels_engine?schema=public"

# Storage Provider abstraction (lib/modules/storage). "local" is the active
# default and is required in every environment without the R2_* vars below.
# "r2" is implemented (R2StorageProvider) but not yet connected to a real
# Cloudflare account — see docs/STORAGE.md before switching to it.
STORAGE_DRIVER="local"
STORAGE_ROOT=".storage"

# Only read when STORAGE_DRIVER="r2". Leave unset for local dev/CI.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""

# Admin (single-passcode gate for V1; swappable for real auth+RBAC later)
ADMIN_PASSCODE=""
ADMIN_SESSION_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Owner Testing Mode — temporary QA-only flag. When "true", every new
# project is auto-marked as paid (Payment provider="owner_test") so the
# rest of the pipeline can be exercised without a real UPI payment. Leave
# unset (or anything other than "true") in production — this is the
# single switch that disables it.
OWNER_TEST_MODE=""

# Instagram Engagement Automation Engine (/api/webhooks/instagram)
# META_APP_SECRET signs/verifies X-Hub-Signature-256 on every inbound event.
# META_WEBHOOK_VERIFY_TOKEN is the arbitrary string configured in the Meta
# App Dashboard's Webhooks setup, echoed back during the GET subscription handshake.
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""

# Optional. Overrides the Graph API base URL (default: https://graph.instagram.com,
# per the Instagram Login OAuth architecture) used for private replies,
# public replies, and post-auth OAuth calls — for pointing at a local
# stand-in during testing only. Leave unset in production.
META_GRAPH_API_BASE_URL=""

# Instagram Login OAuth (Business Login for Instagram — no linked Facebook
# Page required). INSTAGRAM_APP_ID/INSTAGRAM_APP_SECRET come from the Meta
# App Dashboard's "Instagram > API setup with Instagram login" section —
# distinct from the top-level Meta App Secret used above for webhook
# signature verification.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_OAUTH_REDIRECT_URI=""

# Optional. Overrides the api.instagram.com base URL (authorize + initial
# code exchange only) for pointing at a local stand-in during testing.
# Leave unset in production.
INSTAGRAM_OAUTH_API_BASE_URL=""

# AES-256-GCM key (32 bytes, base64-encoded) used by lib/crypto.ts to
# encrypt SocialAccount.pageAccessToken at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# HMAC key signing the OAuth CSRF state cookie. Separate from
# ADMIN_SESSION_SECRET — different trust boundary, same one-secret-per-concern
# pattern as the rest of this file.
OAUTH_STATE_SECRET=""
