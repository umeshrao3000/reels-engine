generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT // created, not yet paid
  PAID // payment confirmed, queued for editing
  IN_PROGRESS // editor working on it
  QUALITY_CHECK
  COMPLETED
  DELIVERED
}

enum PaymentStatus {
  PENDING // gateway order created, awaiting customer action (Razorpay path)
  PENDING_VERIFICATION // customer submitted a UTR, awaiting manual admin review (UPI path)
  PAID
  FAILED
  REJECTED // admin reviewed and rejected the claimed UPI payment
  REFUNDED
}

enum UploadKind {
  ORIGINAL
  PROCESSED
}

enum UploadSourceType {
  DIRECT // uploaded to our Storage Service
  GOOGLE_DRIVE
  DROPBOX
  ONEDRIVE
  WETRANSFER
  URL
}

model Project {
  id          String        @id @default(cuid())
  status      ProjectStatus @default(DRAFT)

  customerName  String?
  email         String?
  phone         String?

  assignedEditor String?

  internalNotes String?
  editorNotes   String?

  revisionCount Int @default(0)

  // Future service flags (Phase 2+ features, not implemented in V1)
  keywordsPackage    Boolean @default(false)
  automationPackage  Boolean @default(false)
  monitoringPackage  Boolean @default(false)

  shareToken    String  @unique @default(cuid()) // powers the no-login customer status page
  downloadCount Int     @default(0)

  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  deliveredAt    DateTime?

  payments  Payment[]
  uploads   Upload[]
  revisions Revision[]

  @@map("projects")
}

model Payment {
  id         String        @id @default(cuid())
  project    Project       @relation(fields: [projectId], references: [id])
  projectId  String

  amount     Int // in paise (₹500 => 50000)
  currency   String        @default("INR")
  provider   String        @default("razorpay") // "manual_upi" | "razorpay"
  providerOrderId   String?
  providerPaymentId String?
  status     PaymentStatus @default(PENDING)

  // Manual UPI verification fields (provider = "manual_upi")
  upiId            String?
  utr              String?
  verifiedAt       DateTime?
  rejectionReason  String?

  createdAt  DateTime      @default(now())

  @@index([projectId])
  @@map("payments")
}

model Upload {
  id          String           @id @default(cuid())
  project     Project          @relation(fields: [projectId], references: [id])
  projectId   String

  kind        UploadKind
  sourceType  UploadSourceType

  // For DIRECT uploads: storage key resolved via the Storage Service.
  // For link-based sources: the external URL as pasted by the customer.
  location    String

  originalFileName String?
  mimeType         String?
  sizeBytes        Int?

  createdAt   DateTime         @default(now())

  @@index([projectId])
  @@map("uploads")
}

model Revision {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String

  note      String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("revisions")
}

// ============================================================
// Instagram Engagement Automation Engine — additive, V1 pivot.
// Project/Payment/Upload/Revision above are untouched and still
// live; this milestone adds new models only, per the agreed
// rollback strategy (no destructive change until the new system
// is proven). See REELS_ENGINE_V1_BLUEPRINT.md.
// ============================================================

enum SocialAccountStatus {
  ACTIVE
  DISCONNECTED
  TOKEN_EXPIRED
}

model SocialAccount {
  id                  String              @id @default(cuid())
  instagramBusinessId String              @unique
  pageAccessToken     String // encrypted at rest via lib/crypto.ts
  instagramUsername   String?
  isConnected         Boolean             @default(true)
  tokenExpiresAt      DateTime? // added in schema review: required for the dashboard's
  // expiry-warning UI (blueprint Section 14/15) — a plain
  // isConnected boolean alone can't distinguish "token expired"
  // from "owner manually disconnected."
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  campaigns           Campaign[]

  @@map("social_accounts")
}

model Campaign {
  id                  String          @id @default(cuid())
  socialAccount       SocialAccount   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  socialAccountId     String
  instagramMediaId    String // target Reel ID
  name                String
  triggerKeywords     String[] // stored lowercase: ["deal", "buy", "link"]
  dmTemplate          String
  publicReplyTemplate String
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  conversionLogs      ConversionLog[]

  @@index([instagramMediaId, isActive])
  @@map("campaigns")
}

model Lead {
  id               String          @id @default(cuid())
  instagramUserId  String          @unique // one Lead per person, across all campaigns
  handle           String?
  lastInteractedAt DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  conversionLogs   ConversionLog[]

  @@map("leads")
}

enum DeliveryStatus {
  PENDING
  MATCHED
  DM_SENT
  PUBLIC_REPLIED
  SUCCESS
  FAILED
  SKIPPED
}

model ConversionLog {
  id              String         @id @default(cuid())
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId      String? // nullable: schema review resolved this so every inbound
  // webhook event can be persisted immediately (per the
  // verify -> persist -> ack -> process order already agreed),
  // including ones that don't match any active campaign.
  lead            Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId          String?
  commentId       String         @unique // idempotency key — one response per comment,
  // also the guard against Meta webhook redelivery.
  commentText     String?
  instagramUserId String?
  matchedKeyword  String?
  status          DeliveryStatus @default(PENDING)
  errorMessage    String?
  dmSentAt        DateTime?
  publicRepliedAt DateTime?
  retryCount      Int            @default(0)
  nextRetryAt     DateTime?
  rawPayload      Json?
  createdAt       DateTime       @default(now())

  @@index([campaignId])
  @@index([status])
  @@map("conversion_logs")
}
