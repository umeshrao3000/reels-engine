generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT // created, not yet paid
  PAID // payment confirmed, queued for editing
  IN_PROGRESS // editor working on it
  QUALITY_CHECK
  COMPLETED
  DELIVERED
}

enum PaymentStatus {
  PENDING // gateway order created, awaiting customer action (Razorpay path)
  PENDING_VERIFICATION // customer submitted a UTR, awaiting manual admin review (UPI path)
  PAID
  FAILED
  REJECTED // admin reviewed and rejected the claimed UPI payment
  REFUNDED
}

enum UploadKind {
  ORIGINAL
  PROCESSED
}

enum UploadSourceType {
  DIRECT // uploaded to our Storage Service
  GOOGLE_DRIVE
  DROPBOX
  ONEDRIVE
  WETRANSFER
  URL
}

model Project {
  id          String        @id @default(cuid())
  status      ProjectStatus @default(DRAFT)

  customerName  String?
  email         String?
  phone         String?

  assignedEditor String?

  internalNotes String?
  editorNotes   String?

  revisionCount Int @default(0)

  // Future service flags (Phase 2+ features, not implemented in V1)
  keywordsPackage    Boolean @default(false)
  automationPackage  Boolean @default(false)
  monitoringPackage  Boolean @default(false)

  shareToken    String  @unique @default(cuid()) // powers the no-login customer status page
  downloadCount Int     @default(0)

  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  deliveredAt    DateTime?

  payments  Payment[]
  uploads   Upload[]
  revisions Revision[]

  @@map("projects")
}

model Payment {
  id         String        @id @default(cuid())
  project    Project       @relation(fields: [projectId], references: [id])
  projectId  String

  amount     Int // in paise (₹500 => 50000)
  currency   String        @default("INR")
  provider   String        @default("razorpay") // "manual_upi" | "razorpay"
  providerOrderId   String?
  providerPaymentId String?
  status     PaymentStatus @default(PENDING)

  // Manual UPI verification fields (provider = "manual_upi")
  upiId            String?
  utr              String?
  verifiedAt       DateTime?
  rejectionReason  String?

  createdAt  DateTime      @default(now())

  @@index([projectId])
  @@map("payments")
}

model Upload {
  id          String           @id @default(cuid())
  project     Project          @relation(fields: [projectId], references: [id])
  projectId   String

  kind        UploadKind
  sourceType  UploadSourceType

  // For DIRECT uploads: storage key resolved via the Storage Service.
  // For link-based sources: the external URL as pasted by the customer.
  location    String

  originalFileName String?
  mimeType         String?
  sizeBytes        Int?

  createdAt   DateTime         @default(now())

  @@index([projectId])
  @@map("uploads")
}

model Revision {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String

  note      String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("revisions")
}

// ============================================================
// Instagram Engagement Automation Engine — additive, V1 pivot.
// Project/Payment/Upload/Revision above are untouched and still
// live; this milestone adds new models only, per the agreed
// rollback strategy (no destructive change until the new system
// is proven). See REELS_ENGINE_V1_BLUEPRINT.md.
// ============================================================

enum SocialAccountStatus {
  ACTIVE
  DISCONNECTED
  TOKEN_EXPIRED
}

model SocialAccount {
  id                  String              @id @default(cuid())
  instagramBusinessId String              @unique
  pageAccessToken     String // encrypted at rest via lib/crypto.ts
  instagramUsername   String?
  isConnected         Boolean             @default(true)
  status              SocialAccountStatus @default(ACTIVE) // OAuth milestone: activates the
  // enum defined above (unused since Milestone 1) — distinguishes
  // user-disconnected from token-expired, which isConnected alone can't.
  tokenExpiresAt      DateTime? // added in schema review: required for the dashboard's
  // expiry-warning UI (blueprint Section 14/15) — a plain
  // isConnected boolean alone can't distinguish "token expired"
  // from "owner manually disconnected."
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  campaigns           Campaign[]

  // Phase A (Automation Reliability): the token-refresh sweep scans for
  // ACTIVE accounts nearing tokenExpiresAt on every cron tick.
  @@index([status, tokenExpiresAt])
  @@map("social_accounts")
}

model Campaign {
  id                  String          @id @default(cuid())
  socialAccount       SocialAccount   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  socialAccountId     String
  instagramMediaId    String // target Reel ID
  name                String
  // Derived cache, not directly editable: always equal to the currently
  // active Keyword rows for this campaign (see lib/modules/keywords), kept
  // in sync transactionally by the Keyword service on every CRUD/toggle.
  // Exists so services/trigger-matcher.ts (Milestone 3) keeps reading a
  // plain lowercase string array unchanged — no matching-engine redesign
  // required for Keyword Management (this milestone) to plug in.
  triggerKeywords     String[]
  dmTemplate          String
  publicReplyTemplate String
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  conversionLogs      ConversionLog[]
  keywords            Keyword[]

  @@index([instagramMediaId, isActive])
  @@map("campaigns")
}

// Keyword Management (additive to the Campaign model, per the agreed
// no-schema-redesign rule): the source of truth for individual keyword
// records (add/edit/delete/enable/disable). Campaign.triggerKeywords is
// derived from the active rows here — the Trigger Matching Engine keeps
// reading that array and is otherwise untouched.
model Keyword {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  value      String // normalized: trimmed, lowercased
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, value])
  @@index([campaignId])
  @@index([campaignId, isActive])
  @@map("keywords")
}

model Lead {
  id               String          @id @default(cuid())
  instagramUserId  String          @unique // one Lead per person, across all campaigns
  handle           String?
  lastInteractedAt DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  conversionLogs   ConversionLog[]

  @@map("leads")
}

enum DeliveryStatus {
  PENDING
  MATCHED
  // Phase A: explicit in-flight claim states. A row sits here only for the
  // duration of one lease (see ConversionLog.claimExpiresAt) while the
  // actual Meta send request is outstanding — never a resting state.
  DM_SENDING
  DM_SENT
  PUBLIC_REPLYING
  PUBLIC_REPLIED
  SUCCESS
  // Phase A: transient failure, eligible for a scheduled retry once
  // nextRetryAt has passed (see ConversionLog.pendingStage for which stage).
  RETRY_PENDING
  // Phase A: blocked because the owning SocialAccount is not
  // ACTIVE+isConnected. Recoverable — resumed automatically once the
  // account reconnects, never auto-retried on a timer.
  ACCOUNT_BLOCKED
  // Phase A: the Meta send request's outcome could not be confirmed (no
  // HTTP response was ever received, or a claim's lease expired before any
  // outcome was recorded — worker crash/timeout after the request may have
  // already gone out). Never auto-resent: surfaced for manual review only,
  // since resending here risks a real duplicate.
  DELIVERY_UNCERTAIN
  // Phase A: terminal, non-retryable — either a permanent/validation
  // failure Meta rejected outright, or a transient failure that exhausted
  // MAX_RETRY_ATTEMPTS. Distinct from DELIVERY_UNCERTAIN: we know for
  // certain the send did not (or must not) succeed.
  DEAD_LETTER
  FAILED // legacy terminal state; kept for backward compatibility with
  // existing rows, no longer written by the pipeline as of Phase A —
  // superseded by RETRY_PENDING/ACCOUNT_BLOCKED/DELIVERY_UNCERTAIN/DEAD_LETTER,
  // which all carry the classification FAILED never did.
  SKIPPED
}

// Phase A: which external Meta call a row is associated with while sitting
// in a non-resting status (RETRY_PENDING/ACCOUNT_BLOCKED/DELIVERY_UNCERTAIN/
// DEAD_LETTER) — determines which stage a recovery sweep resumes.
enum PipelineStage {
  PRIVATE_REPLY
  PUBLIC_REPLY
}

// Phase A: how a Meta API (or token-refresh) failure was classified — see
// lib/modules/meta/meta-api-error.ts. Never derived from message-string
// matching; always derived from HTTP status / Meta error code, or from the
// complete absence of an HTTP response (AMBIGUOUS).
enum MetaErrorClassification {
  TRANSIENT
  PERMANENT
  AUTH
  AMBIGUOUS
}

model ConversionLog {
  id              String         @id @default(cuid())
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId      String? // nullable: schema review resolved this so every inbound
  // webhook event can be persisted immediately (per the
  // verify -> persist -> ack -> process order already agreed),
  // including ones that don't match any active campaign.
  lead            Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId          String?
  commentId       String         @unique // idempotency key — one response per comment,
  // also the guard against Meta webhook redelivery.
  commentText     String?
  instagramUserId String?
  matchedKeyword  String?
  status          DeliveryStatus @default(PENDING)
  errorMessage    String?
  dmSentAt        DateTime?
  publicRepliedAt DateTime?
  retryCount      Int            @default(0)
  nextRetryAt     DateTime?

  // Phase A (Automation Reliability) — atomic claim/lease, structured
  // failure classification, and captured Meta message ids. All additive;
  // no existing column changed or removed.

  // Set when a row is atomically claimed into DM_SENDING/PUBLIC_REPLYING;
  // a stale-claim recovery sweep looks for expired leases here and moves
  // the row to DELIVERY_UNCERTAIN (never back to a resendable status).
  claimExpiresAt             DateTime?
  // Last time a send was actually attempted (claim acquired), success or
  // failure — distinct from createdAt/dmSentAt/publicRepliedAt.
  lastAttemptAt               DateTime?
  // Which external stage this row is waiting/blocked/dead-lettered at.
  // Set on RETRY_PENDING/ACCOUNT_BLOCKED/DELIVERY_UNCERTAIN/DEAD_LETTER,
  // cleared on resolution.
  pendingStage                 PipelineStage?
  lastFailureClassification    MetaErrorClassification?
  lastMetaErrorStatus          Int?
  lastMetaErrorCode            Int?
  lastMetaErrorSubcode         Int?
  privateReplyMessageId       String?
  publicReplyId                String?

  rawPayload      Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Retry-due sweep: rows in RETRY_PENDING whose nextRetryAt has passed.
  @@index([status, nextRetryAt])
  // Stale-claim sweep: rows in DM_SENDING/PUBLIC_REPLYING whose lease
  // (claimExpiresAt) has expired.
  @@index([status, claimExpiresAt])
  @@index([campaignId])
  @@index([status])
  @@map("conversion_logs")
}

// Phase A: single-row lock so overlapping cron invocations (e.g. a slow
// run still in flight when the next scheduled tick fires) never process
// the same batch concurrently. A dedicated row (rather than a Postgres
// advisory lock) because Prisma's pooled connections don't guarantee the
// acquire and release of a session-scoped advisory lock happen on the same
// underlying connection — this uses the same atomic conditional-update
// pattern as everything else in this milestone instead.
model CronLock {
  id          String    @id
  lockedAt    DateTime?
  lockedUntil DateTime?
  // Random per-acquisition token, required to release. Without this, a
  // holder whose lease already expired (and was reclaimed by a new
  // holder) could still call release and clear the *new* holder's lock —
  // release must prove it's releasing the lock it actually acquired, not
  // just the lock with this id.
  ownerToken  String?

  @@map("cron_locks")
}

// MR-3.1 (Beta SaaS Build Program): customer identity, entirely separate
// from the admin/ops passcode gate (lib/modules/admin/session.ts), which
// stays untouched — this is a new, additive identity system for people
// paying for the Automation Engine, not a replacement for the internal
// admin surface. Field/model shapes here are dictated by better-auth
// (lib/auth/server.ts), not chosen freely — see
// node_modules/@better-auth/core/dist/db/schema/*.mjs for the canonical
// shape this mirrors. No relation yet to Campaign/SocialAccount/etc.;
// that linkage is MR-3.2 (Single Organization Model), explicitly out of
// scope for this milestone.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  @@unique([email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("sessions")
}

// One row per sign-in method a user has. For email+password (the only
// method MR-3.1 enables), providerId is always "credential" and the
// scrypt password hash lives in `password` — better-auth's own design,
// not this table's password field being reused for anything else.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

// Short-lived tokens for password-reset (MR-3.1) and, later, email
// verification — one generic table, per better-auth's own design.
model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}
